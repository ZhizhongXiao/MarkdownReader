# ===== Python =====
# 字节码缓存
__pycache__/
*.py[cod]

# 虚拟环境
venv/
.venv/

# ===== 测试与代码检查缓存 =====
.pytest_cache/
.pytest-tmp-*/
.ruff_cache/

# ===== 构建与打包产物 =====
output/
dist/
build/
*.spec
!packaging/MarkdownReader.spec
packaging/.pyinstaller-build/
# 内置 Node 运行时（本地准备，不进版本库；spec 在构建期强制要求已放入）
packaging/node/

# ===== Node / 前端依赖 =====
node_renderer/node_modules/
# 测试专用的 jsdom 测试层（不进打包：spec 只收集 gui/assets、templates、node_renderer）
tests/js/node_modules/
# 新 renderer 自己的依赖（不进打包；spec 只收集 gui/assets、templates、node_renderer）
renderer/node_modules/

# ===== 本地产物（编辑器 / 系统 / 覆盖率）=====
.env*
.env.local
Thumbs.db
Desktop.ini
.DS_Store
.coverage
coverage.xml
htmlcov/
*.log

# ===== IDE =====
.vscode/
.idea/

# ===== 工具目录 =====
.agents/
.codex/

# ===== 运行时配置（由程序写入，不进版本库）=====
config.json
MarkdownReader.log
