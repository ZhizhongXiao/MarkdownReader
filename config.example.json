{
  "build": {
    "input": "C:/path/to/your/markdown",
    "template": "modern",
    "output": "C:/path/to/output",
    "external_themes": [
      "paper"
    ]
  },
  "document": {
    "numbering": false
  },
  "features": {
    "build_index": false,
    "auto_open": true,
    "preserve_structure": true
  }
}
